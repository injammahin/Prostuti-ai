          position: relative;
        }
        .ps__toc-item a {
          display: block;
          padding: 0.4rem 0.85rem;
          margin-left: -1.5px;
          color: var(--text-secondary);
          text-decoration: none;
          font-size: 0.86rem;
          line-height: 1.45;
          border-left: 1.5px solid transparent;
          transition: all 200ms ease;
        }
        .ps__toc-item a:hover {
          color: var(--text-primary);
          border-left-color: var(--border-strong);
        }
        .ps__toc-item.is-sub a {
          padding-left: 1.5rem;
          font-size: 0.82rem;
          color: var(--text-muted);
        }
        .ps__toc-item.is-active a {
          color: var(--color-brand-orange);
          border-left-color: var(--color-brand-orange);
          font-weight: 600;
        }

        .ps__cta {
          background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand-orange) 8%, transparent) 0%, color-mix(in srgb, var(--color-brand-blue) 5%, transparent) 100%);
          border: 1px solid color-mix(in srgb, var(--color-brand-orange) 22%, var(--border));
