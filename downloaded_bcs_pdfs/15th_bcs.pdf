          width: 48px;
          height: 48px;
          border-radius: var(--radius-lg);
          background: linear-gradient(135deg, var(--color-brand-orange) 0%, var(--color-brand-red) 100%);
          color: white;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          margin-bottom: 0.25rem;
          box-shadow: 0 8px 18px -4px color-mix(in srgb, var(--color-brand-orange) 50%, transparent);
        }
        .ps__cta h4 {
          margin: 0;
          font-size: 1rem;
          font-weight: 700;
          color: var(--text-primary);
        }
        .ps__cta p {
          margin: 0;
          color: var(--text-secondary);
          font-size: 0.85rem;
          line-height: 1.55;
        }
        .ps__cta-btn {
          margin-top: 0.45rem;
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
          padding: 0.65rem 1.25rem;
          background: linear-gradient(135deg, var(--color-brand-orange) 0%, var(--color-brand-red) 100%);
          color: white;
          text-decoration: none;
          border-radius: var(--radius-full);
          font-weight: 700;
          font-size: 0.88rem;
          box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--color-brand-orange) 50%, transparent);
          transition: transform 150ms ease, box-shadow 150ms ease;
        }
        .ps__cta-btn:hover {
          transform: translateY(-1px);
          box-shadow: 0 12px 24px -6px color-mix(in srgb, var(--color-brand-orange) 65%, transparent);
        }

        .ps__tags {
          background: var(--bg-card);
          border: 1px solid var(--border);
          border-radius: var(--radius-xl);
          padding: 1.1rem 1.15rem 1.15rem;
        }
        .ps__tags h4 {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
          margin: 0 0 0.75rem;
          font-size: 0.85rem;
          font-weight: 700;
          color: var(--text-muted);
          text-transform: uppercase;
          letter-spacing: 0.04em;
        }
        .ps__tags ul {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-direction: column;
          gap: 0.35rem;
        }
        .ps__tags li a {
          display: block;
          padding: 0.5rem 0.75rem;
          border: 1px solid var(--border);
          border-radius: var(--radius-md);
          color: var(--text-secondary);
          text-decoration: none;
          font-size: 0.86rem;
          line-height: 1.4;
          transition: all 180ms ease;
        }
        .ps__tags li a:hover {
          color: white;
          background: var(--color-brand-blue);
          border-color: var(--color-brand-blue);
        }

        .ps__newsletter {
