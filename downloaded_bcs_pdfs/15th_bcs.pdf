        .nl {
          padding: 1.85rem 1.65rem;
          background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand-orange) 12%, transparent) 0%, color-mix(in srgb, var(--color-brand-blue) 8%, transparent) 100%);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: var(--radius-2xl);
          margin: 2rem 0;
        }
        .nl__inner {
          display: flex;
          flex-direction: column;
          gap: 1.25rem;
        }
        @media (min-width: 800px) {
          .nl__inner {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
          }
          .nl__copy { flex: 1; }
        }
        .nl__copy h3 {
          margin: 0 0 0.4rem;
          font-size: 1.1rem;
          color: white;
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
        }
        .nl__copy p {
          margin: 0;
          color: rgba(255, 255, 255, 0.72);
          font-size: 0.9rem;
          line-height: 1.55;
          max-width: 460px;
        }
        .nl__form {
          width: 100%;
          max-width: 460px;
        }
        @media (min-width: 800px) {
          .nl__form { width: auto; min-width: 380px; }
        }
        .nl__field {
          position: relative;
          display: flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.4rem 0.4rem 0.4rem 1rem;
          background: rgba(255, 255, 255, 0.06);
          border: 1px solid rgba(255, 255, 255, 0.16);
          border-radius: var(--radius-full);
          transition: border-color 200ms ease, background 200ms ease;
        }
        .nl__field:focus-within {
          border-color: var(--color-brand-orange);
          background: rgba(255, 255, 255, 0.10);
        }
        .nl__field > :global(svg):first-child,
        .nl__field > svg:first-child {
          color: rgba(255, 255, 255, 0.55);
          flex-shrink: 0;
        }
        .nl__field input {
          flex: 1;
          min-width: 0;
          padding: 0.55rem 0;
          background: transparent;
          border: none;
          color: white;
          font-family: inherit;
          font-size: 0.92rem;
          outline: none;
        }
        .nl__field input::placeholder { color: rgba(255, 255, 255, 0.5); }
        /* Kill browser autofill yellow/white background */
        .nl__field input:-webkit-autofill,
        .nl__field input:-webkit-autofill:hover,
        .nl__field input:-webkit-autofill:focus,
        .nl__field input:-webkit-autofill:active {
          -webkit-text-fill-color: white !important;
          -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
          box-shadow: 0 0 0px 1000px transparent inset !important;
          transition: background-color 9999s ease-in-out 0s;
          caret-color: white;
        }
        .nl__field input:autofill {
          background: transparent !important;
          color: white !important;
        }
        .nl__submit {
          flex-shrink: 0;
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
          padding: 0.6rem 1.1rem;
          background: linear-gradient(135deg, var(--color-brand-orange) 0%, var(--color-brand-red) 100%);
          border: none;
          border-radius: var(--radius-full);
          color: white;
          font-weight: 700;
          font-size: 0.88rem;
          cursor: pointer;
          transition: transform 150ms ease, box-shadow 150ms ease, opacity 150ms ease;
          box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--color-brand-orange) 55%, transparent);
          white-space: nowrap;
        }
        .nl__submit:hover:not(:disabled) {
          transform: translateY(-1px);
          box-shadow: 0 12px 24px -6px color-mix(in srgb, var(--color-brand-orange) 70%, transparent);
        }
        .nl__submit:disabled { opacity: 0.55; cursor: not-allowed; }
        .nl__msg {
          margin: 0.5rem 0 0;
          font-size: 0.85rem;
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
        }
