          padding: 1.1rem 1.15rem;
        }
        .ps__newsletter h4 {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
          margin: 0 0 0.4rem;
          font-size: 0.95rem;
          font-weight: 700;
          color: var(--text-primary);
        }
        .ps__newsletter p {
          margin: 0 0 0.85rem;
          color: var(--text-secondary);
          font-size: 0.85rem;
          line-height: 1.5;
        }
        .ps__news-btn {
          display: inline-flex;
