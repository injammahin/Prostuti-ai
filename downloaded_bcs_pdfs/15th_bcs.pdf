        .ps {
          display: flex;
          flex-direction: column;
          gap: 1.25rem;
        }

        .ps__toc {
          background: var(--bg-card);
          border: 1px solid var(--border);
          border-radius: var(--radius-xl);
          padding: 1.1rem 1.15rem 1.25rem;
          max-height: calc(100vh - 120px);
          overflow-y: auto;
          overflow-x: hidden;
          scrollbar-width: thin;
          scrollbar-gutter: stable;
        }
        .ps__toc::-webkit-scrollbar {
          width: 6px;
        }
        .ps__toc::-webkit-scrollbar-thumb {
          background: var(--border-strong);
          border-radius: var(--radius-full);
        }
        .ps__toc h4 {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
          margin: 0 0 0.85rem;
          font-size: 0.85rem;
          font-weight: 700;
          color: var(--text-muted);
          text-transform: uppercase;
          letter-spacing: 0.04em;
        }
        .ps__toc ul {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-direction: column;
          gap: 0.1rem;
          border-left: 1.5px solid var(--border);
        }
        .ps__toc-item {
          position: relative;
        }
        .ps__toc-item a {
          display: block;
          padding: 0.4rem 0.85rem;
          margin-left: -1.5px;
          color: var(--text-secondary);
          text-decoration: none;
          font-size: 0.86rem;
          line-height: 1.45;
          border-left: 1.5px solid transparent;
          transition: all 200ms ease;
        }
        .ps__toc-item a:hover {
          color: var(--text-primary);
          border-left-color: var(--border-strong);
        }
        .ps__toc-item.is-sub a {
          padding-left: 1.5rem;
          font-size: 0.82rem;
          color: var(--text-muted);
        }
        .ps__toc-item.is-active a {
          color: var(--color-brand-orange);
          border-left-color: var(--color-brand-orange);
          font-weight: 600;
        }

        .ps__cta {
          background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand-orange) 8%, transparent) 0%, color-mix(in srgb, var(--color-brand-blue) 5%, transparent) 100%);
          border: 1px solid color-mix(in srgb, var(--color-brand-orange) 22%, var(--border));
          border-radius: var(--radius-xl);
          padding: 1.4rem 1.25rem;
          text-align: center;
          display: flex;
