conColor&quot;:[0],&quot;badgeText&quot;:[0],&quot;badgeColor&quot;:[0],&quot;groupHeading&quot;:[0],&quot;isFeatured&quot;:[0,false]}],[0,{&quot;label&quot;:[0,&quot;রিসোর্স লাইব্রেরি&quot;],&quot;href&quot;:[0,&quot;/resources&quot;],&quot;description&quot;:[0,&quot;PDF, ভিডিও ও স্টাডি গাইড&quot;],&quot;external&quot;:[0,false],&quot;iconName&quot;:[0,&quot;book-closed&quot;],&quot;iconColor&quot;:[0],&quot;badgeText&quot;:[0],&quot;badgeColor&quot;:[0],&quot;groupHeading&quot;:[0],&quot;isFeatured&quot;:[0,false]}],[0,{&quot;label&quot;:[0,&quot;প্রশ্ন করুন&quot;],&quot;href&quot;:[0,&quot;/ask&quot;],&quot;description&quot;:[0,&quot;মেন্টরদের সাথে সরাসরি প্রশ্নোত্তর&quot;],&quot;external&quot;:[0,false],&quot;iconName&quot;:[0,&quot;help&quot;],&quot;iconColor&quot;:[0],&quot;badgeText&quot;:[0],&quot;badgeColor&quot;:[0],&quot;groupHeading&quot;:[0],&quot;isFeatured&quot;:[0,false]}],[0,{&quot;label&quot;:[0,&quot;জব সার্কুলার&quot;],&quot;href&quot;:[0,&quot;/blog/category/job-circular&quot;],&quot;description&quot;:[0,&quot;সকল জব সার্কুলার পাবেন এখানে&quot;],&quot;external&quot;:[0,false],&quot;iconName&quot;:[0,&quot;briefcase&quot;],&quot;iconColor&quot;:[0],&quot;badgeText&quot;:[0],&quot;badgeColor&quot;:[0],&quot;groupHeading&quot;:[0],&quot;isFeatured&quot;:[0,false]}]]]}],[0,{&quot;label&quot;:[0,&quot;যোগাযোগ&quot;],&quot;href&quot;:[0,&quot;/contact&quot;],&quot;external&quot;:[0,false],&quot;description&quot;:[0],&quot;iconName&quot;:[0],&quot;iconColor&quot;:[0],&quot;badgeText&quot;:[0],&quot;badgeColor&quot;:[0],&quot;isMegaMenu&quot;:[0,false],&quot;megaMenuColumns&quot;:[0,2],&quot;megaMenuImage&quot;:[0],&quot;megaMenuFooterText&quot;:[0],&quot;megaMenuFooterUrl&quot;:[0],&quot;children&quot;:[0]}]]],&quot;logoLight&quot;:[0,&quot;https://web.livemcq.app/uploads/Live_MCQ_Dark_Logo_4393288529.png&quot;],&quot;logoDark&quot;:[0,&quot;https://web.livemcq.app/uploads/Live_MCQ_Light_Logo_e9a9c9f315.png&quot;],&quot;data-astro-cid-kl3rn3iu&quot;:[0,true]}" ssr client="idle" opts="{&quot;name&quot;:&quot;MobileMenu&quot;,&quot;value&quot;:true}" await-children><button type="button" class="mm-trigger" aria-label="মেনু খুলুন" aria-expanded="false"><span></span></button><style>
        .mm-trigger {
          width: 42px;
          height: 42px;
          border-radius: var(--radius-md);
          border: 1.5px solid var(--border);
          background: var(--bg-surface);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          color: var(--text-primary);
          transition: border-color 150ms ease, background 150ms ease;
        }
        .mm-trigger:hover {
          border-color: var(--text-muted);
          background: var(--bg-muted);
        }

        .mm-portal {
          position: fixed;
          inset: 0;
          z-index: 9999;
          pointer-events: none;
        }
        .mm-portal.is-open {
          pointer-events: auto;
        }

        .mm-overlay {
          position: absolute;
          inset: 0;
          background: rgba(8, 8, 16, 0.55);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
          opacity: 0;
          transition: opacity 280ms cubic-bezier(0.4, 0, 0.2, 1);
          border: none;
          cursor: pointer;
        }
        .mm-portal.is-open .mm-overlay {
          opacity: 1;
        }

        .mm-panel {
          position: absolute;
          top: 0;
          right: 0;
          bottom: 0;
          width: min(380px, 92vw);
          background: var(--bg-surface);
          color: var(--text-primary);
          display: flex;
          flex-direction: column;
          transform: translateX(100%);
          transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1);
          box-shadow: -30px 0 80px -20px rgba(8, 8, 16, 0.35);
          will-change: transform;
        }
        .mm-portal.is-open .mm-panel {
          transform: translateX(0);
        }

        .mm-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1.1rem 1.25rem;
          border-bottom: 1px solid var(--border);
          flex-shrink: 0;
        }
        .mm-brand {
          display: inline-flex;
          align-items: center;
          gap: 0.6rem;
          color: inherit;
          text-decoration: none;
        }
        .mm-brand-text {
          font-weight: 700;
          font-size: 1.1rem;
          letter-spacing: -0.01em;
          color: var(--text-primary);
        }
        /* Uploaded brand logo — dark/light swap, same pattern as Logo.astro. */
        .mm-brand-img-wrap {
          display: inline-flex;
          align-items: center;
        }
        .mm-brand-img {
          display: block;
          height: 36px;
          width: auto;
          max-width: 160px;
          object-fit: contain;
        }
        /* :global() is Astro-only and breaks in React inline styles — use bare attribute selectors */
        .mm-brand-img--dark { display: none; }
        [data-theme='dark'] .mm-brand-img--light { display: none; }
        [data-theme='dark'] .mm-brand-img--dark { display: block; }
        .mm-brand-img-wrap > .mm-brand-img:only-child { display: block; }
        .mm-close {
          width: 40px;
          height: 40px;
          border-radius: var(--radius-md);
          background: var(--bg-muted);
          color: var(--text-secondary);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          transition: background 150ms ease, color 150ms ease;
        }
        .mm-close:hover {
          background: var(--color-interactive, var(--color-brand-orange));
          color: var(--color-interactive-text, white);
        }

        .mm-body {
          flex: 1;
          overflow-y: auto;
          padding: 1rem 1.25rem 1.5rem;
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
          -webkit-overflow-scrolling: touch;
        }

        .mm-list {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-direction: column;
          gap: 0.15rem;
        }
        .mm-list > li > a {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0.95rem 1rem;
          font-weight: 600;
          color: var(--text-primary);
          border-radius: var(--radius-md);
          transition: background 150ms ease, color 150ms ease, transform 150ms ease;
          min-height: 48px;
        }
        .mm-list > li > a:hover {
          background: var(--bg-muted);
          color: var(--color-interactive, var(--color-brand-orange));
          transform: translateX(4px);
        }
        .mm-list > li > a > svg {
          opacity: 0.4;
          transition: opacity 150ms ease, transform 150ms ease;
        }
        .mm-list > li > a:hover > svg {
          opacity: 1;
          transform: translateX(2px);
        }

        .mm-group {
          display: flex;
          flex-direction: column;
        }
        .mm-group-row {
          display: flex;
          align-items: stretch;
          width: 100%;
          border-radius: var(--radius-md);
          min-height: 48px;
          transition: background 150ms ease;
        }
        .mm-group-row:hover {
          background: var(--bg-muted);
        }
        .mm-group-link {
          flex: 1;
          display: inline-flex;
          align-items: center;
          padding: 0.95rem 0.5rem 0.95rem 1rem;
          font-weight: 600;
          color: var(--text-primary);
          border-radius: var(--radius-md) 0 0 var(--radius-md);
          transition: color 150ms ease;
        }
        .mm-group-row:hover .mm-group-link {
          color: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-group-chev {
          flex-shrink: 0;
          width: 48px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          color: var(--text-muted);
          background: transparent;
          border: none;
          border-radius: 0 var(--radius-md) var(--radius-md) 0;
          cursor: pointer;
          /* Border visually separates this tap target from the label link */
          border-left: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
          transition: background 150ms ease, color 150ms ease, transform 200ms ease;
        }
        .mm-group-chev:hover {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 12%, transparent);
          color: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-group-chev > svg {
          transition: transform 200ms ease;
          opacity: 0.7;
        }
        .mm-group.is-open .mm-group-chev > svg {
          transform: rotate(180deg);
          opacity: 1;
          color: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-group-panel {
          padding: 0.25rem 0 0.45rem;
          display: flex;
          flex-direction: column;
          gap: 0.4rem;
        }
        .mm-group-bucket {
          display: flex;
          flex-direction: column;
          gap: 0.2rem;
        }
        .mm-group-heading {
          margin: 0.4rem 0 0.15rem 1.15rem;
          font-size: 0.7rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: var(--text-muted);
        }
        .mm-group-panel ul {
          list-style: none;
          margin: 0;
          padding: 0;
          display: flex;
          flex-direction: column;
          gap: 0.15rem;
          margin-left: 0.5rem;
          padding-left: 0.65rem;
          border-left: 2px solid var(--border);
        }
        .mm-group-foot {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          margin-top: 0.4rem;
          margin-left: 0.5rem;
          padding: 0.7rem 0.85rem;
          font-weight: 600;
          color: var(--color-interactive, var(--color-brand-orange));
          border-radius: var(--radius-md);
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 7%, transparent);
        }
        .mm-group-foot:hover {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 14%, transparent);
        }
        .mm-group-label {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          flex-wrap: wrap;
        }
        .mm-group-panel a.is-featured {
          background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--color-brand-yellow) 10%, transparent),
            color-mix(in srgb, var(--color-brand-orange) 6%, transparent)
          );
        }
        .nav-badge {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          padding: 0.12rem 0.5rem;
          font-size: 0.62rem;
          font-weight: 700;
          line-height: 1.4;
          border-radius: var(--radius-full);
          text-transform: uppercase;
          letter-spacing: 0.04em;
          white-space: nowrap;
          flex-shrink: 0;
        }
        .nav-badge--blue { background: var(--nav-badge-blue-bg); color: var(--nav-badge-blue-text); }
        .nav-badge--green { background: var(--nav-badge-green-bg); color: var(--nav-badge-green-text); }
        .nav-badge--red { background: var(--nav-badge-red-bg); color: var(--nav-badge-red-text); }
        .nav-badge--yellow { background: var(--nav-badge-yellow-bg); color: var(--nav-badge-yellow-text); }
        .nav-badge--orange { background: var(--nav-badge-orange-bg); color: var(--nav-badge-orange-text); }
        .nav-badge--purple { background: var(--nav-badge-purple-bg); color: var(--nav-badge-purple-text); }
        .nav-badge--pink { background: var(--nav-badge-pink-bg); color: var(--nav-badge-pink-text); }
        .nav-badge--gray { background: var(--bg-muted); color: var(--text-secondary); }
        .mm-group-panel a {
          display: flex;
          align-items: flex-start;
          gap: 0.6rem;
          padding: 0.65rem 0.75rem;
          border-radius: var(--radius-md);
          color: var(--text-secondary);
          transition: background 150ms ease, color 150ms ease;
        }
        .mm-group-panel a:hover {
          background: var(--bg-muted);
          color: var(--text-primary);
        }
        .mm-child-icon {
          flex-shrink: 0;
          width: 28px;
          height: 28px;
          border-radius: var(--radius-md);
          background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand-yellow) 18%, transparent), color-mix(in srgb, var(--color-brand-orange) 18%, transparent));
          color: var(--color-brand-orange);
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }
        .mm-child-text {
          display: flex;
          flex-direction: column;
          gap: 0.1rem;
          min-width: 0;
          flex: 1;
        }
        .mm-child-label {
          font-weight: 600;
          font-size: 0.95rem;
          color: var(--text-primary);
          line-height: 1.3;
        }
        .mm-child-desc {
          font-size: 0.75rem;
          color: var(--text-muted);
          line-height: 1.4;
        }

        .mm-list > li > a.is-active,
        .mm-list > li > a[aria-current='page'] {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 12%, transparent);
          color: var(--color-interactive, var(--color-brand-orange));
          font-weight: 700;
          position: relative;
        }
        .mm-list > li > a.is-active::before,
        .mm-list > li > a[aria-current='page']::before {
          content: '';
          position: absolute;
          left: 0;
          top: 12%;
          bottom: 12%;
          width: 3px;
          border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
          background: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-list > li > a.is-active > svg,
        .mm-list > li > a[aria-current='page'] > svg {
          opacity: 1;
        }
        .mm-group.has-active-child > .mm-group-row .mm-group-link,
        .mm-group-link.is-active,
        .mm-group-link[aria-current='page'] {
          color: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-group-link.is-active,
        .mm-group-link[aria-current='page'] {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 12%, transparent);
          font-weight: 700;
          position: relative;
        }
        .mm-group-link.is-active::before,
        .mm-group-link[aria-current='page']::before {
          content: '';
          position: absolute;
          left: 0;
          top: 12%;
          bottom: 12%;
          width: 3px;
          border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
          background: var(--color-interactive, var(--color-brand-orange));
        }
        .mm-group-panel a.is-active,
        .mm-group-panel a[aria-current='page'] {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 12%, transparent);
          color: var(--color-interactive, var(--color-brand-orange));
          font-weight: 700;
        }
        .mm-group-panel a.is-active .mm-child-icon,
        .mm-group-panel a[aria-current='page'] .mm-child-icon {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 18%, transparent);
          color: var(--color-interactive, var(--color-brand-orange));
        }

        .mm-auth {
          margin-top: 1.5rem;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 0.6rem;
        }
        .mm-auth__btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.45rem;
          padding: 0.78rem 0.9rem;
          font-size: 0.95rem;
          font-weight: 600;
          border-radius: var(--radius-full);
          text-decoration: none;
          border: 1.5px solid var(--border);
          transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
        }
        .mm-auth__btn--ghost {
          background: var(--bg-card);
          color: var(--text-primary);
        }
        .mm-auth__btn--ghost:hover {
          border-color: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 40%, var(--border));
          color: var(--color-interactive, var(--color-brand-orange));
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 6%, var(--bg-card));
        }
        .mm-auth__btn--solid {
          background: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 12%, var(--bg-card));
          color: var(--color-interactive, var(--color-brand-orange));
          border-color: color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 28%, transparent);
        }
        .mm-auth__btn--solid:hover {
          background: var(--color-interactive, var(--color-brand-orange));
          color: var(--color-interactive-text, #fff);
          border-color: var(--color-interactive, var(--color-brand-orange));
          transform: translateY(-1px);
        }

        .mm-cta {
          margin-top: 0.75rem;
          width: 100%;
          padding: 1.05rem 1.25rem !important;
          font-size: 1rem;
        }

        /* Logged-in account block — slim identity card + quick logout. */
        .mm-account {
          margin-top: 1.25rem;
          display: flex;
          flex-direction: column;
          gap: 0.6rem;
        }
        .mm-account__card {
          display: flex;
          align-items: center;
          gap: 0.85rem;
          padding: 1rem 1.1rem;
          border-radius: var(--radius-xl);
          background:
            radial-gradient(ellipse 80% 100% at 100% 0%, color-mix(in srgb, var(--color-brand-yellow) 18%, transparent), transparent 60%),
            linear-gradient(135deg, var(--color-brand-orange) 0%, var(--color-brand-orange-hover) 100%);
          color: #fff;
        }
        .mm-account__avatar {
          flex-shrink: 0;
          width: 44px; height: 44px;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.2);
          border: 2px solid rgba(255, 255, 255, 0.3);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-weight: 800;
          font-size: 1.1rem;
          color: #fff;
          overflow: hidden;
        }
        .mm-account__avatar--photo { background: transparent; }
        .mm-account__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 50%; }
        .mm-account__text {
          flex: 1;
          min-width: 0;
          display: flex;
          flex-direction: column;
          gap: 0.1rem;
        }
        .mm-account__name {
          font-size: 1rem;
          font-weight: 700;
          line-height: 1.3;
          color: #fff;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .mm-account__sub {
          font-size: 0.78rem;
          font-style: normal;
          color: rgba(255, 255, 255, 0.85);
        }
        .mm-account__id {
          flex-shrink: 0;
          align-self: center;
          padding: 0.25rem 0.55rem;
          background: rgba(255, 255, 255, 0.18);
          border: 1px solid rgba(255, 255, 255, 0.28);
          color: #fff;
          font-size: 0.68rem;
          font-weight: 700;
          letter-spacing: 0.02em;
          border-radius: var(--radius-full);
          white-space: nowrap;
        }
        .mm-account__exam {
          width: 100%;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          padding: 0.85rem 1rem;
          min-height: 48px;
          font-size: 0.95rem;
          font-weight: 700;
          border-radius: var(--radius-full);
          border: 1px solid transparent;
          background: var(--color-brand-blue);
          color: #fff;
          text-decoration: none;
          transition: background 160ms ease, transform 160ms ease;
        }
        .mm-account__exam:hover, .mm-account__exam:active {
          background: var(--color-brand-blue-dark);
          color: #fff;
          transform: translateY(-1px);
        }
        .mm-account__logout {
          width: 100%;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          padding: 0.85rem 1rem;
          min-height: 48px;
          font-size: 0.95rem;
          font-weight: 700;
          border-radius: var(--radius-full);
          border: 1px solid color-mix(in srgb, var(--color-danger) 28%, transparent);
          background: color-mix(in srgb, var(--color-danger) 7%, transparent);
          color: var(--color-danger);
          cursor: pointer;
          transition: background 160ms ease, color 160ms ease, transform 160ms ease;
        }
        .mm-account__logout:hover, .mm-account__logout:active {
          background: var(--color-danger);
          color: #fff;
          transform: translateY(-1px);
        }
      </style><!--astro:end--></astro-island>  </span> </div> </div> </header>  <div class="cstrip" data-cstrip data-id="winter-sale-2026" data-start="1793469600000" data-end="1797184799000" data-astro-cid-cxdeyhtk> <span class="cstrip__bg" aria-hidden="true" data-astro-cid-cxdeyhtk>  <span class="cstrip__hills" data-astro-cid-cxdeyhtk></span> <svg class="cstrip__trees cstrip__trees--l" viewBox="0 0 200 104" preserveAspectRatio="xMinYMax meet" data-astro-cid-cxdeyhtk> <g fill="#173f86" fill-opacity=".85" data-astro-cid-cxdeyhtk> <path d="M30 104 L48 20 L66 104Z" data-astro-cid-cxdeyhtk></path> <path d="M70 104 L84 44 L98 104Z" data-astro-cid-cxdeyhtk></path> <path d="M0 104 L14 34 L28 104Z" data-astro-cid-cxdeyhtk></path> <path d="M110 104 L120 64 L130 104Z" data-astro-cid-cxdeyhtk></path> </g> <g fill="#eaf4ff" data-astro-cid-cxdeyhtk> <path d="M42 48 L48 20 L54 48 L48 42Z" data-astro-cid-cxdeyhtk></path> <path d="M80 62 L84 44 L88 62 L84 58Z" data-astro-cid-cxdeyhtk></path> </g> </svg> <svg class="cstrip__trees cstrip__trees--r" viewBox="0 0 200 104" preserveAspectRatio="xMinYMax meet" data-astro-cid-cxdeyhtk> <g fill="#173f86" fill-opacity=".85" data-astro-cid-cxdeyhtk> <path d="M30 104 L48 16 L66 104Z" data-astro-cid-cxdeyhtk></path> <path d="M72 104 L86 50 L100 104Z" data-astro-cid-cxdeyhtk></path> <path d="M0 104 L14 30 L28 104Z" data-astro-cid-cxdeyhtk></path> </g> <g fill="#eaf4ff" data-astro-cid-cxdeyhtk> <path d="M42 44 L48 16 L54 44 L48 38Z" data-astro-cid-cxdeyhtk></path> </g> </svg>  <span class="cstrip__snow" data-astro-cid-cxdeyhtk> <i style="--x:67.47%;--s:2.85px;--d:12.62s;--dl:-0.9s;--swd:2.43s;--o:0.72;--b:0px" data-astro-cid-cxdeyhtk><b class="sw3" data-astro-cid-cxdeyhtk></b></i><i style="--x:96.11%;--s:2.98px;--d:12.16s;--dl:-10.06s;--swd:3.57s;--o:0.75;--b:0px" data-astro-cid-cxdeyhtk><b class="sw2" data-astro-cid-cxdeyhtk></b></i><i style="--x:5.37%;--s:2.09px;--d:7.84s;--dl:-0.39s;--swd:3.84s;--o:0.57;--b:0px" data-astro-cid-cxdeyhtk><b clas