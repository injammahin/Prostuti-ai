# Lines to ADD to the existing /home/cfbusygx/ai-exam/.htaccess. Nothing in that file is removed or replaced.
# Keep a copy of the old file first. Deploy the backend and the new build BEFORE adding these.

# ===== BLOCK 1: directly after "RewriteEngine On" =====

# One address for everyone: https, without www
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} !=443
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://bd3schools.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bd3schools.com%{REQUEST_URI} [R=301,L]

# No second copies of pages and files
RewriteRule ^index\.html$ https://bd3schools.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/_spa/
RewriteRule ^_spa/(.*)$ https://bd3schools.com/$1 [R=301,L]

# ===== BLOCK 2: directly above "# 4. Everything else -> React" =====

# 3a. App pages -> React
RewriteRule ^(app|login|signup|onboarding|bcs-papers|doctors)(/.*)?$ _spa/index.html [L]

# 3b. Public pages (with their text) and real 404s -> Laravel
RewriteRule ^ index.php [L]

# PDF files stay downloadable but out of search results (the pages under /bcs are the ones to find)
<IfModule mod_headers.c>
  # Do not tell which PHP version runs the site
  Header unset X-Powered-By
  Header always unset X-Powered-By
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
