 </div> <script>
      (function () {
        var el = document.querySelector("[data-cstrip]");
        if (!el) return;
        var start = +el.dataset.start;
        var end = +el.dataset.end;
        var key = "lmcq:cstrip:" + el.dataset.id;
        var BN = "০১২৩৪৫৬৭৮৯";
        var pad = function (n) {
          return String(n).padStart(2, "0").replace(/\d/g, function (d) { return BN[d]; });
        };
        var dismissed = false;
        try { dismissed = sessionStorage.getItem(key) === "1"; } catch (e) {}
        var nodes = el.querySelectorAll("[data-u]");
        var timer = 0;
        var painted = false;
        var calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var setVal = function (slot, txt) {
          var cur = slot.lastElementChild;
          if (cur.textContent === txt) return;
          if (!painted || calm) {
            cur.textContent = txt;
            return;
          }
          var next = cur.cloneNode(false);
          next.className = "cstrip__v cstrip__v--in";
          next.textContent = txt;
          cur.className = "cstrip__v cstrip__v--out";
          slot.appendChild(next);
          setTimeout(function () { if (cur.parentNode) cur.remove(); }, 500);
        };
        var tick = function () {
          var now = Date.now();
          if (dismissed || now < start || now >= end) {
            el.hidden = true;
            if (timer) clearInterval(timer);
            return false;
          }
          var s = Math.floor((end - now) / 1000);
          var v = { d: Math.floor(s / 86400), h: Math.floor((s % 86400) / 3600), m: Math.floor((s % 3600) / 60), s: s % 60 };
          nodes.forEach(function (n) {
            var t = pad(v[n.dataset.u]);
            setVal(n.children[0], t[0]);
            setVal(n.children[1], t[1]);
          });
          painted = true;
          return true;
        };
        if (tick()) timer = setInterval(tick, 1000);
        el.querySelector("[data-cstrip-close]").addEventListener("click", function () {
          dismissed = true;
          try { sessionStorage.setItem(key, "1"); } catch (e) {}
          tick();
        });
      })();
</script>   <main id="main-content">  <astro-island uid="Z26GOQW" prefix="r5" component-url="/_astro/ReadingProgress.CIgBj30c.js" component-export="default" renderer-url="/_astro/client.1XWY8Wsf.js" props="{&quot;targetSelector&quot;:[0,&quot;.post__body&quot;],&quot;data-astro-cid-zg7dkzxc&quot;:[0,true]}" ssr client="idle" opts="{&quot;name&quot;:&quot;ReadingProgress&quot;,&quot;value&quot;:true}" await-children><div class="rp" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="পড়ার অগ্রগতি"><div class="rp__bar" style="width:0%"></div><style>
        .rp {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          height: 3px;
          background: rgba(0, 0, 0, 0.06);
          z-index: 200;
          pointer-events: none;
        }
        .rp__bar {
          height: 100%;
          background: linear-gradient(90deg, var(--color-brand-yellow) 0%, var(--color-brand-orange) 50%, var(--color-brand-red) 100%);
          transition: width 100ms linear;
          box-shadow: 0 0 12px color-mix(in srgb, var(--color-brand-orange) 60%, transparent);
        }
      </style></div><!--astro:end--></astro-island> <article class="post" style="--p: #EC4899; --s: var(--color-brand-red);" data-astro-cid-zg7dkzxc> <header class="post__head" data-astro-cid-zg7dkzxc> <div class="container" data-astro-cid-zg7dkzxc> <a href="/blog" class="post__back" data-astro-cid-zg7dkzxc> <svg width="14" height="14" viewBox="0 0 24 24" class="icon icon--arrow-left" aria-hidden="true" data-icon="lucide:arrow-left">   <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 19l-7-7l7-7m7 7H5"/> </svg>
