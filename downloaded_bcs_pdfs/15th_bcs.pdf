l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"></path></svg><span>Google</span></button><button type="button" class="social-auth__btn social-auth__btn--facebook" aria-busy="false"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12c0-6.6-5.4-12-12-12S0 5.4 0 12c0 6 4.4 11 10.1 11.9V15.5H7.1V12h3v-2.6c0-3 1.8-4.6 4.5-4.6 1.3 0 2.7.2 2.7.2v2.9h-1.5c-1.5 0-1.9.9-1.9 1.9V12h3.3l-.5 3.5h-2.7v8.4C19.6 23 24 18 24 12z"></path></svg><span>Facebook</span></button><style>
        .social-auth {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 0.65rem;
        }
        .social-auth__btn {
          appearance: none;
          width: 100%;
          padding: 0.8rem 1rem;
          min-height: 50px;
          border-radius: var(--radius-lg);
          font-size: 0.95rem;
          font-weight: 600;
          letter-spacing: 0.005em;
          font-family: inherit;
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.55rem;
          line-height: 1;
          transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
          border: 1.5px solid var(--border-strong);
          background: var(--bg-card);
          color: var(--text-primary);
        }
        .social-auth__btn > svg,
        .social-auth__btn > .social-auth__spinner {
          flex-shrink: 0;
        }
        .social-auth__btn > span {
          display: inline-block;
          line-height: 1.2;
          transform: translateY(0.5px);
        }
        .social-auth__notice,
        .social-auth__error {
          grid-column: 1 / -1;
        }
        @media (max-width: 380px) {
          .social-auth { grid-template-columns: 1fr; }
        }
        .social-auth__btn:hover:not(:disabled) {
          transform: translateY(-1px);
          box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.18);
        }
        .social-auth__btn:active:not(:disabled) {
          transform: translateY(0);
        }
        .social-auth__btn:disabled {
          opacity: 0.6;
          cursor: not-allowed;
        }
        .social-auth__btn--google:hover:not(:disabled) {
          border-color: rgba(66, 133, 244, 0.45);
          background: linear-gradient(180deg, rgba(66, 133, 244, 0.04), var(--bg-card));
        }
        .social-auth__btn--facebook {
          background: linear-gradient(180deg, #1877F2 0%, #1463cf 100%);
          color: white;
          border-color: transparent;
        }
        .social-auth__btn--facebook:hover:not(:disabled) {
          box-shadow: 0 10px 22px -12px rgba(24, 119, 242, 0.55);
        }
        .social-auth__btn--facebook svg path {
          fill: white !important;
        }
        .social-auth__spinner {
          width: 16px;
          height: 16px;
          border-radius: 50%;
          border: 2px solid currentColor;
          border-top-color: transparent;
          animation: socialSpin 700ms linear infinite;
          opacity: 0.75;
        }
        @keyframes socialSpin {
          to { transform: rotate(360deg); }
        }
        .social-auth__notice {
          margin: 0;
          padding: 0.55rem 0.75rem;
          background: color-mix(in srgb, var(--color-brand-yellow) 14%, transparent);
          color: var(--text-secondary);
          font-size: 0.78rem;
          border-radius: var(--radius-md);
          text-align: center;
        }
        .social-auth__error {
          margin: 0;
          color: var(--color-danger, #dc2626);
          font-size: 0.85rem;
          text-align: center;
        }
      </style></div><div class="cm-gate__alt"><a href="/login?next=%2F"><span></span> মোবাইল OTP দিয়ে লগইন করুন</a><span class="cm-gate__sep">·</span><a href="/signup?next=%2F">নতুন অ্যাকাউন্ট খুলুন</a></div></div><style>
        .cm {
          margin-top: 3rem;
          padding-top: 2.5rem;
          border-top: 1px solid var(--border);
        }
        .cm__head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          margin-bottom: 1.5rem;
        }
        .cm__head h2 {
          display: inline-flex;
          align-items: center;
          gap: 0.55rem;
          font-size: 1.4rem;
          margin: 0;
        }
        .cm__count {
          padding: 0.18rem 0.6rem;
          background: var(--color-brand-orange);
          color: white;
          font-size: 0.78rem;
          border-radius: var(--radius-full);
          font-weight: 700;
          margin-left: 0.4rem;
        }
        .cm__loading, .cm__empty, .cm__disabled {
          color: var(--text-muted);
          font-style: italic;
          padding: 1.5rem 0;
          text-align: center;
        }
        .cm-list {
          list-style: none;
          padding: 0;
          margin: 0 0 2.5rem;
          display: flex;
          flex-direction: column;
          gap: 1.25rem;
        }
        .cm-item article {
          display: flex;
          gap: 0.85rem;
          padding: 1.1rem 1.15rem;
          background: var(--bg-card);
          border: 1px solid var(--border);
          border-radius: var(--radius-lg);
        }
        .cm-item.depth-1 article { background: var(--bg-muted); }
        .cm-item.depth-2 article { background: var(--bg-muted); border-style: dashed; }
        .cm-item.is-admin article {
          background: color-mix(in srgb, var(--color-brand-blue) 6%, var(--bg-card));
          border-color: color-mix(in srgb, var(--color-brand-blue) 30%, var(--border));
          box-shadow: 0 4px 14px -10px color-mix(in srgb, var(--color-brand-blue) 40%, transparent);
        }
        .cm-item__avatar {
          flex-shrink: 0;
          width: 40px; height: 40px;
          border-radius: 50%;
          background: linear-gradient(135deg, var(--color-brand-orange), var(--color-brand-red));
          color: white;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-weight: 700;
          font-size: 1.05rem;
          overflow: hidden;
        }
        .cm-item__avatar--photo { background: var(--bg-muted); }
        .cm-item__avatar img {
          width: 100%; height: 100%;
          object-fit: cover;
          display: block;
        }
        .cm-item__avatar--brand {
          background: #fff;
          border: 1px solid color-mix(in srgb, var(--color-brand-blue) 22%, var(--border));
          padding: 5px;
          box-shadow: 0 2px 8px -4px color-mix(in srgb, var(--color-brand-blue) 45%, transparent);
        }
        .cm-item__avatar--brand img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
        .cm-item__badge {
          display: inline-flex;
          align-items: center;
          padding: 0.12rem 0.5rem;
          background: color-mix(in srgb, var(--color-brand-blue) 16%, transparent);
          color: var(--color-brand-blue);
          border-radius: var(--radius-full);
          font-size: 0.68rem;
          font-weight: 700;
          letter-spacing: 0.01em;
        }
        .cm-item__body { flex: 1; min-width: 0; }
        .cm-item__body header {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-bottom: 0.45rem;
          flex-wrap: wrap;
        }
        .cm-item__body header time {
          margin-left: auto;
        }
        .cm-item__body strong, .cm-item__body strong a {
          color: var(--text-primary);
          font-weight: 700;
          text-decoration: none;
        }
        .cm-item__body strong a:hover { color: var(--color-brand-orange); }
        .cm-item__body time {
          color: var(--text-muted);
          font-size: 0.8rem;
        }
        .cm-item__content {
          margin: 0;
          color: var(--text-secondary);
          line-height: 1.65;
          white-space: pre-wrap;
          word-wrap: break-word;
        }
        .cm-item__content .cm-item__link {
          color: var(--color-brand-blue);
          text-decoration: none;
          font-weight: 600;
          overflow-wrap: anywhere;
          border-bottom: 1px solid color-mix(in srgb, var(--color-brand-blue) 35%, transparent);
          transition: color 0.15s ease, border-color 0.15s ease;
        }
        .cm-item__content .cm-item__link:hover {
          color: var(--color-brand-blue-dark);
          border-bottom-color: currentColor;
        }
        .cm-item__reply {
          display: inline-flex;
          align-items: center;
          gap: 0.3rem;
          margin-top: 0.55rem;
          background: none;
          border: none;
          color: var(--color-brand-orange);
          font-size: 0.82rem;
          cursor: pointer;
          padding: 0.2rem 0;
          font-weight: 600;
          font-family: inherit;
        }
        .cm-item__reply:hover { text-decoration: underline; }
        .cm-children {
          list-style: none;
          padding: 0;
          margin: 0.75rem 0 0 2.5rem;
          display: flex;
          flex-direction: column;
          gap: 0.85rem;
        }
        @media (max-width: 600px) {
          .cm-children { margin-left: 1.25rem; }
        }

        .cm-form {
          padding: 1.65rem 1.5rem;
          background: var(--bg-card);
          border: 1px solid var(--border);
          border-radius: var(--radius-xl);
          display: flex;
          flex-direction: column;
          gap: 0.85rem;
        }
        .cm-form h3 {
          margin: 0 0 0.35rem;
          font-size: 1.1rem;
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
        }
        .cm-form__cancel {
          margin-left: auto;
          background: none;
          border: 1px solid var(--border);
          color: var(--text-muted);
          padding: 0.2rem 0.65rem;
          border-radius: var(--radius-full);
          font-size: 0.78rem;
          cursor: pointer;
          font-family: inherit;
        }
        .cm-form__cancel:hover {
          color: var(--color-brand-orange);
          border-color: var(--color-brand-orange);
        }
        .cm-form__row {
          display: grid;
          grid-template-columns: 1fr;
          gap: 0.85rem;
        }
        @media (min-width: 600px) {
          .cm-form__row { grid-template-columns: 1fr 1fr; }
        }
        .cm-form label {
          display: flex;
          flex-direction: column;
          gap: 0.35rem;
          position: relative;
        }
        .cm-form label > span {
          font-size: 0.85rem;
          font-weight: 600;
          color: var(--text-secondary);
        }
        .cm-form label > span em {
          color: var(--color-danger);
          font-style: normal;
        }
        .cm-form input, .cm-form textarea {
          padding: 0.65rem 0.85rem;
          border: 1px solid var(--border-strong);
          border-radius: var(--radius-md);
          background: var(--bg-primary);
          color: var(--text-primary);
          font-family: inherit;
          font-size: 0.93rem;
          resize: vertical;
        }
        .cm-form input:focus, .cm-form textarea:focus {
          outline: none;
          border-color: var(--color-interactive, var(--color-brand-orange));
          box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-interactive, var(--color-brand-orange)) 15%, transparent);
        }
        .cm-form__counter {
          position: absolute;
          right: 0.5rem;
          bottom: 0.5rem;
          font-size: 0.72rem;
          color: var(--text-muted);
          background: var(--bg-card);
          padding: 0 0.4rem;
          border-radius: var(--radius-sm);
        }
        .cm-form button[type="submit"] {
          align-self: flex-start;
          margin-top: 0.45rem;
        }
        .cm-form__msg {
          margin: 0.5rem 0 0;
          font-size: 0.88rem;
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
        }
        .cm-form__msg--ok { color: var(--color-success); }
        .cm-form__msg--err { color: var(--color-danger); }

        .cm-gate {
          padding: 2rem 1.6rem;
          background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--color-brand-orange) 5%, var(--bg-card)),
            var(--bg-card)
          );
          border: 1.5px solid color-mix(in srgb, var(--color-brand-orange) 18%, var(--border));
          border-radius: var(--radius-xl);
          text-align: center;
          display: flex;
          flex-direction: column;
          gap: 0.85rem;
          align-items: center;
        }
        .cm-gate__icon {
          width: 52px;
          height: 52px;
          border-radius: 50%;
          background: linear-gradient(135deg, var(--color-brand-orange), color-mix(in srgb, var(--color-brand-orange) 60%, var(--color-brand-yellow)));
          color: white;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--color-brand-orange) 50%, transparent);
        }
        .cm-gate h3 {
          margin: 0;
          font-size: 1.15rem;
          font-weight: 700;
          color: var(--text-primary);
        }
        .cm-gate p {
          margin: 0;
          color: var(--text-secondary);
          font-size: 0.9rem;
          line-height: 1.6;
          max-width: 420px;
        }
        .cm-gate :global(.social-auth) {
          width: 100%;
          max-width: 360px;
          margin-top: 0.4rem;
        }
        .cm-gate__alt {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          margin-top: 0.4rem;
          font-size: 0.84rem;
          color: var(--text-muted);
          flex-wrap: wrap;
          justify-content: center;
        }
        .cm-gate__alt a {
          color: var(--color-brand-orange);
          text-decoration: none;
          font-weight: 600;
          display: inline-flex;
          align-items: center;
          gap: 0.3rem;
        }
        .cm-gate__alt a:hover {
          text-decoration: underline;
        }
        .cm-gate__sep {
          opacity: 0.5;
        }

        .cm-form__identity {
          display: flex;
          align-items: center;
          gap: 0.7rem;
          padding: 0.65rem 0.85rem;
          background: color-mix(in srgb, var(--color-brand-blue) 5%, var(--bg-muted));
          border: 1px solid color-mix(in srgb, var(--color-brand-blue) 18%, var(--border));
          border-radius: var(--radius-md);
          margin-bottom: 0.4rem;
        }
        .cm-form__avatar {
          width: 36px;
          height: 36px;
          border-radius: 50%;
          background: linear-gradient(135deg, var(--color-brand-orange), var(--color-brand-red));
          color: white;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-weight: 700;
          font-size: 0.95rem;
          flex-shrink: 0;
          overflow: hidden;
        }
        .cm-form__avatar--photo { background: var(--bg-muted); }
        .cm-form__avatar img {
          width: 100%; height: 100%;
          object-fit: cover;
          display: block;
        }
        .cm-form__identity-text {
          display: flex;
          flex-direction: column;
          line-height: 1.3;
          min-width: 0;
        }
        .cm-form__identity-text strong {
          font-size: 0.92rem;
          color: var(--text-primary);
          font-weight: 700;
        }
        .cm-form__identity-text em {
          font-style: normal;
          font-size: 0.74rem;
          color: var(--text-muted);
        }
